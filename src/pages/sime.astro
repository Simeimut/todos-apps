---
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Mi Página</title>
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        height: 100vh;
        background-image: url('/fondo.jpeg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        font-family: sans-serif;
        color: black;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      nav {
        width: 100%;
        padding: 1rem;
        text-align: center;
      }

      nav a {
        color: black;
        margin: 0 1rem;
        text-decoration: none;
        font-weight: bold;
      }

      nav a:hover {
        text-decoration: underline;
      }

      h1 {
        margin-top: 100px;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/sime">My page</a>
    </nav>

    <h1>HI world</h1>
  </body>
</html>
